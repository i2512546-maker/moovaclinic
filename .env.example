# ============================================================
# MOOVA CLINIC — variables de entorno del monolito modular
# Una sola app Flask y seis modulos internos, cada uno con su esquema MySQL.
# ============================================================

# Flask
# SECRET_KEY es OBLIGATORIO: no se genera por defecto. Déjala en .env al arrancar.
SECRET_KEY=tu_clave_secreta_aqui

# Clave para las llamadas internas entre módulos.
API_KEY=tu_api_key_interna

# Solo para desarrollo local: permite arrancar la app sin API_KEY
# (deja la auth interna abierta, solo con warning en el log).
# NO la definas en produccion ni en Render.
# ALLOW_INSECURE_INTERNAL_API=1

# MySQL compartido por los siete esquemas.
DB_HOST=mysql-moovacloud.alwaysdata.net
DB_USER=tu_usuario
DB_PASSWORD=tu_contraseña
DB_NAME=moovacloud_auth
DB_PORT=3306
AUTH_DB_NAME=moovacloud_auth
PACIENTES_DB_NAME=moovacloud_pacientes
CITAS_DB_NAME=moovacloud_citas
PAGOS_DB_NAME=moovacloud_pagos
NOTAS_DB_NAME=moovacloud_notas
AUDIT_DB_NAME=moovacloud_auditoria
KPIS_DB_NAME=moovacloud_kpis

# APISperu (validacion de DNI)
APIPERU_TOKEN=tu_token_de_apisperu
APIPERU_URL=https://dniruc.apisperu.com/api/v1/dni/{dni}?token={token}

# TextBee SMS (OTP, confirmaciones y recordatorios)
TEXTBEE_API_KEY=tu_api_key_textbee
TEXTBEE_DEVICE_ID=tu_device_id_textbee
TEXTBEE_URL=https://api.textbee.dev/api/v1/gateway/devices/{device_id}/send-sms

# Token requerido para autenticar el webhook del proveedor de pagos.
WEBHOOK_PROVIDER_TOKEN=tu_token_secreto_webhook_pagos

# ============================================================
# OTP (expiracion y maximo de intentos)
# ============================================================
OTP_EXPIRA_MIN=10
OTP_MAX_INTENTOS=3

# Minutos que el GATEWAY da por vigente una identidad ya verificada en
# la sesion del navegador (S1). Durante ese lapso no vuelve a pedir el
# codigo para ver las citas de ese DNI, cancelarlas o modificarlas.
# Se mide por accion y por DNI: verificar un DNI no habilita a otro.
OTP_SESION_MIN=15

# ============================================================
# LIMITE DE INTENTOS DE LOGIN (gateway)
# El gateway corta el intento antes de llamar al modulo de autenticacion. Dos
# contadores independientes: por IP (quien fuerza claves desde un
# equipo) y por correo (quien fuerza un correo desde muchas IPs).
# Ambos tienen que pasar.
# ============================================================
LOGIN_MAX_INTENTOS=5
LOGIN_VENTANA_MIN=10
LOGIN_BLOQUEO_MIN=15

# 1 = el gateway esta detras de un proxy (Render/ nginx) y la IP real
# se toma del PRIMER valor de X-Forwarded-For. Dejalo en 0 si no hay
# proxy: cualquiera podria mandar el header inventado y quedar sin
# contador.
TRUST_PROXY=0

# ============================================================
# RECORDATORIOS AUTOMATICOS (modulo de citas)
# Deshabilitados por defecto. Si RECORDATORIOS_ENABLED=1, el
# scheduler envia SMS de aviso de las citas del
# dia siguiente pasada la hora RECORDATORIO_HORA (America/Lima).
# El endpoint manual /api/citas/recordatorios/enviar funciona
# aunque el scheduler este apagado.
# ============================================================
RECORDATORIOS_ENABLED=0
RECORDATORIO_HORA=18:00
RECORDATORIO_INTERVALO_MIN=15
# Liberación horaria de pagos vencidos y sus citas asociadas.
LIBERAR_VENCIDOS_ENABLED=1

# ============================================================
# REPORTE DE RIESGO DE FUGA (modulo de citas)
# Dias sin venir, sin cita programada, a partir de los cuales un
# paciente pasa a listarse en /panel_admin/riesgo.
# ============================================================
RIESGO_DIAS_UMBRAL=30


# --- NIUBIZ (tarjeta débito/crédito) ---
# Modo: sandbox (pruebas) | live (producción)
NIUBIZ_MODE=sandbox
NIUBIZ_SANDBOX_URL=https://apisandbox.vnforappstest.com
NIUBIZ_LIVE_URL=https://api.viacel.com
NIUBIZ_USER=tu_usuario_niubiz
NIUBIZ_PASSWORD=tu_clave_niubiz
NIUBIZ_MERCHANT_ID=tu_merchant_id
NIUBIZ_SDK_URL=

# --- YAPE EMPRESAS (BCP) ---
YAPE_API_URL=https://api.yape.com.pe
YAPE_CLIENT_ID=tu_client_id_yape
YAPE_CLIENT_SECRET=tu_client_secret_yape
YAPE_MERCHANT_ID=tu_numero_negocio_yape

# --- PLIN EMPRESAS (multi-banco) ---
PLIN_API_URL=https://api.plin.com.pe
PLIN_CLIENT_ID=tu_client_id_plin
PLIN_CLIENT_SECRET=tu_client_secret_plin
PLIN_MERCHANT_ID=tu_numero_negocio_plin