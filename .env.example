# Flask
SECRET_KEY=tu_clave_secreta_aqui

# MySQL
DB_HOST=localhost
DB_USER=tu_usuario
DB_PASSWORD=tu_contraseña
DB_NAME=tu_base_de_datos
DB_PORT=3306

# APISperu
APIPERU_TOKEN=tu_token_de_apisperu
APIPERU_URL=https://dniruc.apisperu.com/api/v1/dni/{dni}?token={token}

# TextBee SMS
TEXTBEE_API_KEY=tu_api_key_textbee
TEXTBEE_DEVICE_ID=tu_device_id_textbee
TEXTBEE_URL=https://api.textbee.dev/api/v1/gateway/devices/{device_id}/send-sms

# API Interna
API_KEY=tu_api_key_interna

# OTP
OTP_EXPIRA_MIN=10
OTP_MAX_INTENTOS=3

# Bloqueo IP
MAX_INTENTOS_IP=3
TIEMPO_BLOQUEO=2

# ============================================================
# PAGOS — INTEGRACIONES REALES (ver PAYMENTS.md para contratar)
# ============================================================

# --- NIUBIZ (tarjeta débito/crédito) ---
# Modo: sandbox (pruebas) | live (producción)
NIUBIZ_MODE=sandbox
NIUBIZ_SANDBOX_URL=https://apisandbox.vnforappstest.com
NIUBIZ_LIVE_URL=https://api.viacel.com
# Credenciales que entrega Niubiz al contratar (sandbox: usu/token de prueba):
NIUBIZ_USER=tu_usuario_niubiz
NIUBIZ_PASSWORD=tu_clave_niubiz
NIUBIZ_MERCHANT_ID=tu_merchant_id
# URL del SDK JS de Niubiz (para cifrar la tarjeta en el navegador):
NIUBIZ_SDK_URL=

# --- YAPE EMPRESAS (BCP) ---
# Contrato "Yape Empresas" con BCP. La URL base y autenticación exactas las
# entrega BCP; los valores de abajo son los estándar (client_credentials).
YAPE_API_URL=https://api.yape.com.pe
YAPE_CLIENT_ID=tu_client_id_yape
YAPE_CLIENT_SECRET=tu_client_secret_yape
YAPE_MERCHANT_ID=tu_numero_negocio_yape

# --- PLIN EMPRESAS (multi-banco) ---
# Acuerdo "Plin Empresas" con un banco participante. La URL y autenticación
# exactas las define el banco.
PLIN_API_URL=https://api.plin.com.pe
PLIN_CLIENT_ID=tu_client_id_plin
PLIN_CLIENT_SECRET=tu_client_secret_plin
PLIN_MERCHANT_ID=tu_numero_negocio_plin
