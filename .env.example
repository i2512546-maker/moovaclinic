# ============================================================
# MOOVA CLINIC — variables de entorno (FASE 2: microservicios)
#
# Cada microservicio tiene su PROPIA base de datos (mismo servidor
# MySQL, distinto DB_NAME). Ver services/<servicio>/.env.example.
#
# GATEWAY: no usa DB_* (toda la lectura/escritura es por HTTP a los
# servicios). El gateway conserva SECRET_KEY + SERVICE_URLS.
# ============================================================

# Flask
SECRET_KEY=tu_clave_secreta_aqui

# API Interna
API_KEY=tu_api_key_interna

# ============================================================
# Tabla de rutas de servicios (el gateway las usa para delegar).
# En local/Railway cada variable apunta al servicio correspondiente.
# ============================================================
AUTH_SERVICE_URL=http://127.0.0.1:5001
PACIENTES_SERVICE_URL=http://127.0.0.1:5002
CITAS_SERVICE_URL=http://127.0.0.1:5003
PAGOS_SERVICE_URL=http://127.0.0.1:5004
NOTAS_SERVICE_URL=http://127.0.0.1:5005
AUDIT_SERVICE_URL=http://127.0.0.1:5006

# ============================================================
# Microservicios
# ============================================================
# (Cada servicio define su propio DB_NAME. Ejemplos dentro de cada
#  services/<servicio>/.env.example)

# ---- auth_service ----
# DB_HOST=...
# DB_USER=...
# DB_PASSWORD=...
# DB_PORT=3306
# DB_NAME=moovacloud_auth
# SECRET_KEY=...
# OTP_EXPIRA_MIN=10
# OTP_MAX_INTENTOS=3

# ---- pacientes_service ----
# DB_NAME=moovacloud_pacientes
# APIPERU_TOKEN=...
# APIPERU_URL=https://dniruc.apisperu.com/api/v1/dni/{dni}?token={token}

# ---- citas_service ----
# DB_NAME=moovacloud_citas
# TEXTBEE_API_KEY=...
# TEXTBEE_DEVICE_ID=...
# TEXTBEE_URL=https://api.textbee.dev/api/v1/gateway/devices/{device_id}/send-sms

# ---- pagos_service ----
# DB_NAME=moovacloud_pagos
# (integradores Niubiz/Yape/Plin: ver PAYMENTS.md)

# ---- notas_service ----
# DB_NAME=moovacloud_notas

# ---- audit_service ----
# DB_NAME=moovacloud_auditoria
# AUDIT_SERVICE_URL debe apuntar a este servicio (lo consumen
# citas_service, pagos_service y el gateway via shared/audit.py).

# ============================================================
# OTP / Bloqueo IP (usados por auth_service y citas_service)
# ============================================================
OTP_EXPIRA_MIN=10
OTP_MAX_INTENTOS=3
MAX_INTENTOS_IP=3
TIEMPO_BLOQUEO=2

# ============================================================
# PAGOS — INTEGRACIONES REALES (ver PAYMENTS.md para contratar)
# Solo necesarias en pagos_service.
# ============================================================

# --- NIUBIZ (tarjeta débito/crédito) ---
# Modo: sandbox (pruebas) | live (producción)
NIUBIZ_MODE=sandbox
NIUBIZ_SANDBOX_URL=https://apisandbox.vnforappstest.com
NIUBIZ_LIVE_URL=https://api.viacel.com
NIUBIZ_USER=tu_usuario_niubiz
NIUBIZ_PASSWORD=tu_clave_niubiz
NIUBIZ_MERCHANT_ID=tu_merchant_id
NIUBIZ_SDK_URL=

# --- YAPE EMPRESAS (BCP) ---
YAPE_API_URL=https://api.yape.com.pe
YAPE_CLIENT_ID=tu_client_id_yape
YAPE_CLIENT_SECRET=tu_client_secret_yape
YAPE_MERCHANT_ID=tu_numero_negocio_yape

# --- PLIN EMPRESAS (multi-banco) ---
PLIN_API_URL=https://api.plin.com.pe
PLIN_CLIENT_ID=tu_client_id_plin
PLIN_CLIENT_SECRET=tu_client_secret_plin
PLIN_MERCHANT_ID=tu_numero_negocio_plin