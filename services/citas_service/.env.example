# citas_service
# FASE 2: usa su propia base moovacloud_citas (Alwaysdata).
SECRET_KEY=tu_clave_secreta_aqui
DB_HOST=mysql-moovacloud.alwaysdata.net
DB_USER=tu_usuario
DB_PASSWORD=tu_contraseña
DB_NAME=moovacloud_citas
DB_PORT=3306

# OTP
OTP_EXPIRA_MIN=10
OTP_MAX_INTENTOS=3

# TextBee SMS
TEXTBEE_API_KEY=tu_api_key_textbee
TEXTBEE_DEVICE_ID=tu_device_id_textbee
TEXTBEE_URL=https://api.textbee.dev/api/v1/gateway/devices/{device_id}/send-sms

# Recordatorios automaticos por SMS.
# Deshabilitados por defecto. Para encenderlos pon
# RECORDATORIOS_ENABLED=1 (el scheduler arranca desde create_app).
RECORDATORIOS_ENABLED=0
RECORDATORIO_HORA=18:00
RECORDATORIO_INTERVALO_MIN=15

# Reporte de pacientes en riesgo de fuga (GET /api/citas/riesgo):
# dias sin venir, sin cita programada, para listarlo como en riesgo.
RIESGO_DIAS_UMBRAL=30

# API Interna
API_KEY=tu_api_key_interna

# Servicios a los que enriquece/delega (pacientes para datos del
# paciente/terapeuta, pagos para anticipos y cancelacion de pago,
# audit para logs):
PACIENTES_SERVICE_URL=http://127.0.0.1:5002
PAGOS_SERVICE_URL=http://127.0.0.1:5004
AUDIT_SERVICE_URL=http://127.0.0.1:5006