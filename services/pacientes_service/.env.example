# pacientes_service
# FASE 2: usa su propia base moovacloud_pacientes (Alwaysdata).
SECRET_KEY=tu_clave_secreta_aqui
DB_HOST=mysql-moovacloud.alwaysdata.net
DB_USER=tu_usuario
DB_PASSWORD=tu_contraseña
DB_NAME=moovacloud_pacientes
DB_PORT=3306

# APISperu (validacion de DNI)
APIPERU_TOKEN=tu_token_de_apisperu
APIPERU_URL=https://dniruc.apisperu.com/api/v1/dni/{dni}?token={token}

# API Interna
API_KEY=tu_api_key_interna

# Servicios a los que enriquece (auth para terapeutas, citas para
# total_visitas/historial, pagos para paquetes):
AUTH_SERVICE_URL=http://127.0.0.1:5001
CITAS_SERVICE_URL=http://127.0.0.1:5003
PAGOS_SERVICE_URL=http://127.0.0.1:5004